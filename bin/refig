#!/bin/bash

if [[ $# == 0 ]]; then
  echo usage: $0 service [services...] 1>&2
  exit 1
fi

services=()
for i in "$@"; do
  services+=( ${i%%/*} )
done

docker-compose stop "${services[@]}"
docker-compose rm -fv "${services[@]}"
docker-compose up -d "${services[@]}"
sleep 2
docker-compose logs "${services[@]}"
